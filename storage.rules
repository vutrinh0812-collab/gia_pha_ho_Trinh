rules_version = '2';

// Photo storage (SPEC §4): public read and upload, images only, < 2 MB.
// Admin mode is a frontend password lock (no Firebase Auth), so uploads cannot be
// limited to the admin here; only the size and type are checked.
// Files live under clans/{clanId}/photos/... (e.g. photos/{personId}/800.jpg and 120.jpg thumbnails).

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin(clanId) {
      return true;
    }

    match /clans/{clanId}/photos/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin(clanId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
      allow delete: if isAdmin(clanId);
    }
  }
}
