{
  "name": "gia-pha-dong-ho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --project demo-gia-pha --import=./.emulator-data --export-on-exit=./.emulator-data",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-gia-pha \"vitest run --config vitest.rules.config.ts\"",
    "test:all": "npm test && npm run test:rules",
    "seed": "tsx scripts/seed.ts",
    "admin:setup": "tsx scripts/setup-admin.ts",
    "dev:demo": "vite --mode demo",
    "build:preview": "tsc -b && vite build --mode demo && node scripts/build-preview.mjs"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
