# --- Firebase web config (Firebase Console → Project settings → Your apps → Web app) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- App ---
# Id of the clan document: data lives under clans/{VITE_CLAN_ID}/...
VITE_CLAN_ID=ho-trinh
# The single admin account. Its password is the "mã admin".
VITE_ADMIN_EMAIL=admin@example.com

# --- Emulator (true = connect to local Firebase Emulator Suite) ---
VITE_USE_EMULATOR=false

# --- App Check (optional, reCAPTCHA v3 site key) ---
VITE_APPCHECK_SITE_KEY=

# --- Site & sharing (Open Graph for Zalo/Facebook, PWA) ---
VITE_APP_TITLE=Gia Phả Họ Trịnh
VITE_APP_SHORT_NAME=Gia phả
VITE_APP_DESCRIPTION=
# Public address once deployed, e.g. https://gia-pha-ho-trinh.web.app — needed for link previews.
VITE_SITE_URL=
# Allow Google to index the site (default: hidden from search engines; link previews still work).
VITE_ALLOW_INDEXING=false
